{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true,
    "es6": true,
    "mocha": true
  },
  "ignorePatterns": [
    "dist/**",
    "vendor/**"
  ],
  "overrides": [
    {
      // test/options/*/{lint,detect} 下有沿用上游目录结构的空占位用例文件
      "files": ["test/**"],
      "rules": {
        "unicorn/no-empty-file": "off"
      }
    }
  ]
}
