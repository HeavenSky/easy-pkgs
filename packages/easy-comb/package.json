{
	"name": "easy-comb",
	"version": "0.0.4",
	"description": "Sort properties and unify the code style of CSS, Less, SCSS and Sass files, with the csscomb command and config files you already use",
	"keywords": [
		"css",
		"csscomb",
		"formatter",
		"less",
		"properties",
		"sass",
		"scss",
		"sort",
		"style"
	],
	"homepage": "https://github.com/HeavenSky/easy-pkgs/tree/main/packages/easy-comb#readme",
	"bugs": {
		"url": "https://github.com/HeavenSky/easy-pkgs/issues"
	},
	"license": "MIT",
	"author": "calla <aurora.calla@outlook.com>",
	"contributors": [
		"Mikhail Troshev <mishanga@yandex-team.ru>",
		"Tony Ganch <tonyganch+github@gmail.com> (http://tonyganch.com/)"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HeavenSky/easy-pkgs.git",
		"directory": "packages/easy-comb"
	},
	"bin": {
		"csscomb": "./bin/csscomb.js"
	},
	"files": [
		"CHANGELOG.md",
		"bin",
		"dist"
	],
	"type": "module",
	"main": "./dist/csscomb.js",
	"types": "./dist/csscomb.d.ts",
	"exports": {
		".": {
			"types": "./dist/csscomb.d.ts",
			"default": "./dist/csscomb.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "mocha",
		"test:official": "node ../_official_style_suites/comb.mjs",
		"sort-order": "node scripts/sort-order.ts",
		"prepack": "npm run build"
	},
	"dependencies": {
		"easy-gonz": "~0.0.2",
		"tinyglobby": "^0.2.17"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.6.5",
		"mdn-data": "^2.37.2",
		"mocha": "^11.8.0",
		"stylelint-config-recess-order": "^7.8.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": "^16.17.0 || >=18.3.0"
	}
}
