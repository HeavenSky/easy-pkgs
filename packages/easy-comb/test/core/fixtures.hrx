        top: 0;
    }
    left: 0;
}

<===> scss/variable.scss
$red: tomato;
div {
    color: $tomato;
}

<===> scss/warn.scss
div {
    @warn "nani";
    top: 0;
}

<===> scss/while.scss
div {
    @while $i > 6 {
        .item {
            width: 2em * $i;
        }
        $i: $i - 2;
    }
}

