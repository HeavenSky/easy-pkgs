<===> css/lines-between-rulesets.css
/*comment*/
.foo {background: red;}/*comment*/.bar{border: 1px solid red;}.baz{color: #fff;}

<===> css/lines-between-rulesets.expected.css
/*comment*/
.foo {background: red;}

/*comment*/.bar{border: 1px solid red;}

.baz{color: #fff;}

