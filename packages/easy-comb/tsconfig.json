{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["node", "mocha"]
	},
	"include": ["src", "test", "scripts"]
}
