					"type": "boolean",
					"default": false,
					"description": "%config.repository.simplifyByDecoration%"
				},
				"easy-graph.repository.showRemoteHeads": {
					"type": "boolean",
					"default": true,
					"description": "%config.repository.showRemoteHeads%"
				},
				"easy-graph.repository.showStashes": {
					"type": "boolean",
					"default": true,
					"description": "%config.repository.showStashes%"
				},
				"easy-graph.repository.showTags": {
					"type": "boolean",
					"default": true,
					"description": "%config.repository.showTags%"
				},
				"easy-graph.repository.showUncommittedChanges": {
					"type": "boolean",
					"default": true,
					"description": "%config.repository.showUncommittedChanges%"
				},
				"easy-graph.repositories": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"markdownDescription": "%config.repositories%"
				},
				"easy-graph.repoSearchExclude": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"**/node_modules"
					],
					"markdownDescription": "%config.repoSearchExclude%"
				},
				"easy-graph.repositoryDropdownOrder": {
					"type": "string",
					"enum": [
						"Full Path",
						"Name",
						"Workspace Full Path"
					],
					"enumDescriptions": [
						"%config.repositoryDropdownOrder.enum.FullPath%",
						"%config.repositoryDropdownOrder.enum.Name%",
						"%config.repositoryDropdownOrder.enum.WorkspaceFullPath%"
					],
					"default": "Workspace Full Path",
					"description": "%config.repositoryDropdownOrder%"
				},
				"easy-graph.retainContextWhenHidden": {
					"type": "boolean",
					"default": true,
					"description": "%config.retainContextWhenHidden%"
				},
				"easy-graph.showStatusBarItem": {
					"type": "boolean",
					"default": true,
					"description": "%config.showStatusBarItem%"
				},
				"easy-graph.sourceCodeProviderIntegrationLocation": {
					"type": "string",
					"enum": [
						"Inline",
						"More Actions"
					],
					"enumDescriptions": [
						"%config.sourceCodeProviderIntegrationLocation.enum.Inline%",
						"%config.sourceCodeProviderIntegrationLocation.enum.MoreActions%"
					],
					"default": "Inline",
					"description": "%config.sourceCodeProviderIntegrationLocation%"
				},
				"easy-graph.stickyHeader": {
					"type": "boolean",
					"default": true,
					"description": "%config.stickyHeader%"
				},
				"easy-graph.toggleViewOnCommand": {
					"type": "boolean",
					"default": false,
					"description": "%config.toggleViewOnCommand%"
				},
				"easy-graph.viewLocation": {
					"type": "string",
					"enum": [
						"editor",
						"panel",
						"both"
					],
					"enumDescriptions": [
						"%config.viewLocation.enum.editor%",
						"%config.viewLocation.enum.panel%",
						"%config.viewLocation.enum.both%"
					],
					"default": "editor",
					"description": "%config.viewLocation%"
				}
			}
		},
		"menus": {
			"commandPalette": [
				{
					"command": "easy-graph.openFile",
					"when": "isInDiffEditor && resourceScheme == easy-graph && easy-graph:codiconsSupported"
				},
				{
					"command": "easy-graph.openWithPathFilter",
					"when": "false"
				},
				{
					"command": "easy-graph.goToCommit",
					"when": "resourceScheme == easy-graph || resourceScheme == git"
				}
			],
			"editor/context": [
				{
					"command": "easy-graph.goToCommit",
					"group": "navigation@100",
					"when": "resourceScheme == easy-graph || resourceScheme == git"
				}
			],
			"explorer/context": [
				{
					"command": "easy-graph.openWithPathFilter",
					"group": "4_search"
				}
			],
			"editor/title": [
				{
					"command": "easy-graph.openFile",
					"group": "navigation",
					"when": "isInDiffEditor && resourceScheme == easy-graph && easy-graph:codiconsSupported"
				},
				{
					"command": "easy-graph.goToCommit",
					"group": "navigation",
					"when": "isInDiffEditor && (resourceScheme == easy-graph || resourceScheme == git)"
				}
			],
			"scm/title": [
				{
					"when": "scmProvider == git && config.easy-graph.sourceCodeProviderIntegrationLocation == 'Inline'",
					"command": "easy-graph.view",
					"group": "navigation"
				},
				{
					"when": "scmProvider == git && config.easy-graph.sourceCodeProviderIntegrationLocation == 'More Actions'",
					"command": "easy-graph.view",
					"group": "inline"
				}
			],
			"scm/repository": [
				{
					"when": "scmProvider == git && config.easy-graph.sourceCodeProviderIntegrationLocation == 'Inline'",
					"command": "easy-graph.view",
					"group": "inline"
				},
				{
					"when": "scmProvider == git && config.easy-graph.sourceCodeProviderIntegrationLocation == 'More Actions'",
					"command": "easy-graph.view",
					"group": "navigation"
				}
			]
		},
		"viewsContainers": {
			"panel": [
				{
					"id": "easy-graph-panel",
					"title": "%view.easy-graph-panel%",
					"icon": "$(git-branch)"
				}
			]
		},
		"views": {
			"easy-graph-panel": [
				{
					"type": "webview",
					"id": "easy-graph.panel",
					"name": "%view.easy-graph.panel%"
				}
			]
		}
	},
	"activationEvents": [
		"onStartupFinished",
		"onWebviewPanel:easy-graph"
	],
	"extensionKind": [
		"workspace"
	],
	"icon": "media/icon.png",
	"engines": {
		"node": ">=22.15.1",
		"vscode": "^1.101.0"
	}
}
