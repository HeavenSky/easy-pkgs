{
	"name": "easy-graph",
	"displayName": "Easy Graph",
	"version": "0.0.1",
	"description": "%extension.description%",
	"categories": [
		"Other"
	],
	"keywords": [
		"action",
		"diff",
		"git",
		"graph",
		"visualise"
	],
	"homepage": "https://github.com/HeavenSky/easy-pkgs/tree/main/packages/easy-graph#readme",
	"bugs": {
		"url": "https://github.com/HeavenSky/easy-pkgs/issues"
	},
	"license": "MIT",
	"author": "calla <aurora.calla@outlook.com>",
	"contributors": [
		"Michael Hutchison <mhutchie@16right.com>",
		"hansu (https://github.com/hansu)"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/HeavenSky/easy-pkgs.git",
		"directory": "packages/easy-graph"
	},
	"publisher": "heavensky",
	"files": [
		"out/extension.js",
		"out/askpass/askpassMain.js",
		"out/askpass/askpass.sh",
		"out/askpass/askpass-empty.sh",
		"out/askpass/ssh-askpass.sh",
		"out/web/out.min.js",
		"out/web/out.min.css",
		"media/icon.png",
		"l10n",
		"package.nls.json",
		"package.nls.zh-cn.json",
		"LICENSE.txt",
		"CHANGELOG.md"
	],
	"main": "./out/extension.js",
	"scripts": {
		"compile": "node build.mjs",
		"build": "node build.mjs --production",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc --noEmit && tsc -p web --noEmit",
		"test": "vitest run",
		"lint": "oxlint --fix",
		"lint:check": "oxlint --deny-warnings",
		"fmt": "oxfmt --write",
		"fmt:check": "oxfmt --check",
		"check": "node scripts/check.mjs",
		"gen:icon": "node scripts/gen-icon.mjs",
		"package": "node scripts/package.mjs",
		"vscode:prepublish": "npm run build"
	},
	"dependencies": {
		"iconv-lite": "^0.7.3"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"vscode-types": "npm:@types/vscode"
	},
	"l10n": "./l10n",
	"contributes": {
		"commands": [
			{
				"category": "%category%",
				"command": "easy-graph.view",
				"title": "%command.view%",
				"icon": "$(git-branch)"
			},
			{
				"category": "%category%",
				"command": "easy-graph.addGitRepository",
				"title": "%command.addGitRepository%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.clearAvatarCache",
				"title": "%command.clearAvatarCache%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.endAllWorkspaceCodeReviews",
				"title": "%command.endAllWorkspaceCodeReviews%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.endSpecificWorkspaceCodeReview",
				"title": "%command.endSpecificWorkspaceCodeReview%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.fetch",
				"title": "%command.fetch%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.goToRef",
				"title": "%command.goToRef%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.refresh",
				"title": "%command.refresh%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.removeGitRepository",
				"title": "%command.removeGitRepository%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.resumeWorkspaceCodeReview",
				"title": "%command.resumeWorkspaceCodeReview%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.switchRepository",
				"title": "%command.switchRepository%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.version",
				"title": "%command.version%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.openFile",
				"title": "%command.openFile%",
				"icon": "$(go-to-file)",
				"enablement": "isInDiffEditor && resourceScheme == easy-graph && easy-graph:codiconsSupported"
			},
			{
				"category": "%category%",
				"command": "easy-graph.openWithPathFilter",
				"title": "%command.openWithPathFilter%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.goToCommit",
				"title": "%command.goToCommit%",
				"icon": "$(git-commit)"
			},
			{
				"category": "%category%",
				"command": "easy-graph.showReflog",
				"title": "%command.showReflog%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.manageBackups",
				"title": "%command.manageBackups%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.resetRememberedDialogChoices",
				"title": "%command.resetRememberedDialogChoices%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.viewInEditor",
				"title": "%command.viewInEditor%"
			},
			{
				"category": "%category%",
				"command": "easy-graph.viewInPanel",
				"title": "%command.viewInPanel%"
			}
		],
		"configuration": {
			"type": "object",
			"title": "%config.title%",
			"properties": {
				"easy-graph.commitDetailsView.autoCenter": {
					"type": "boolean",
					"default": true,
					"description": "%config.commitDetailsView.autoCenter%"
				},
				"easy-graph.commitDetailsView.autoScroll": {
					"type": "boolean",
					"default": true,
					"description": "%config.commitDetailsView.autoScroll%"
				},
				"easy-graph.commitDetailsView.fileView.fileTree.compactFolders": {
					"type": "boolean",
					"default": true,
					"description": "%config.commitDetailsView.fileView.fileTree.compactFolders%"
				},
				"easy-graph.commitDetailsView.fileView.type": {
					"type": "string",
					"enum": [
						"File Tree",
						"File List"
					],
					"enumDescriptions": [
						"%config.commitDetailsView.fileView.type.enum.FileTree%",
						"%config.commitDetailsView.fileView.type.enum.FileList%"
					],
					"default": "File Tree",
					"description": "%config.commitDetailsView.fileView.type%"
				},
				"easy-graph.commitDetailsView.hiddenFields": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"parents",
							"branches",
							"tags",
							"containedInBranches",
							"author",
							"committer",
							"date",
							"changes",
							"notes"
						]
					},
					"uniqueItems": true,
					"default": [],
					"description": "%config.commitDetailsView.hiddenFields%"
				},
				"easy-graph.commitDetailsView.location": {
					"type": "string",
					"enum": [
						"Inline",
						"Docked to Bottom"
					],
					"enumDescriptions": [
						"%config.commitDetailsView.location.enum.Inline%",
						"%config.commitDetailsView.location.enum.DockedtoBottom%"
					],
					"default": "Inline",
					"description": "%config.commitDetailsView.location%"
				},
				"easy-graph.builtin": {
					"type": "object",
					"default": {
						"core.abbrev": 7,
						"log.mailmap": false,
						"merge.ff": false,
						"push.autoSetupRemote": true,
						"status.showUntrackedFiles": "all"
					},
					"markdownDescription": "%config.builtin%",
					"properties": {
						"commit.gpgSign": {
							"type": [
								"boolean",
								"null"
							],
							"description": "%config.builtin.commit.gpgSign%"
						},
						"core.abbrev": {
							"type": [
								"integer",
								"null"
							],
							"minimum": 4,
							"maximum": 40,
							"description": "%config.builtin.core.abbrev%"
						},
						"fetch.prune": {
							"type": [
								"boolean",
								"null"
							],
							"description": "%config.builtin.fetch.prune%"
						},
						"fetch.pruneTags": {
							"type": [
								"boolean",
								"null"
							],
							"description": "%config.builtin.fetch.pruneTags%"
						},
						"fetch.tags": {
							"type": [
								"boolean",
								"null"
							],
							"description": "%config.builtin.fetch.tags%"
						},
						"log.mailmap": {
							"type": [
								"boolean",
								"null"
							],
							"description": "%config.builtin.log.mailmap%"
						},
						"merge.ff": {
							"enum": [
								true,
								false,
								"only",
								null
							],
							"description": "%config.builtin.merge.ff%"
						},
						"pull.ff": {
							"enum": [
								true,
								false,
								"only",
								null
							],
							"description": "%config.builtin.pull.ff%"
						},
						"push.autoSetupRemote": {
							"type": [
								"boolean",
								"null"
							],
							"description": "%config.builtin.push.autoSetupRemote%"
						},
						"status.showUntrackedFiles": {
							"enum": [
								"no",
								"normal",
								"all",
								null
							],
							"description": "%config.builtin.status.showUntrackedFiles%"
						},
						"tag.gpgSign": {
							"type": [
								"boolean",
								"null"
							],
							"description": "%config.builtin.tag.gpgSign%"
						}
					},
					"additionalProperties": false
				},
