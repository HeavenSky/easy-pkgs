{
  "name": "easy-mok",
  "description": "Write each API mock once, then switch scenes, delays, and status codes in your browser and save real responses as mocks, with no code edits or dev server restarts.",
  "keywords": [
    "mock",
    "mock-server",
    "api-mock",
    "mock-api",
    "mock-data",
    "middleware",
    "dev-server",
    "vite-plugin",
    "webpack-dev-server",
    "express",
    "fastify",
    "proxy",
    "msw-alternative"
  ],
  "version": "0.0.2",
  "homepage": "https://github.com/HeavenSky/easy-pkgs/tree/main/packages/easy-mok#readme",
  "bugs": {
    "url": "https://github.com/HeavenSky/easy-pkgs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeavenSky/easy-pkgs.git",
    "directory": "packages/easy-mok"
  },
  "license": "MIT",
  "author": "calla <aurora.calla@outlook.com>",
  "type": "commonjs",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "bin": {
    "easy-mok": "./dist/server/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist/server",
    "src/float/loader.js",
    "dist/ui"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config vite.config.mts && vite build --config vite.float.config.mts",
    "dev:ui": "vite --config vite.config.mts",
    "dev:server": "node test/dev-server.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "body-parser": "^2.3.0",
    "chokidar": "^4.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "http-proxy-middleware": "^3.0.7",
    "jiti": "^2.7.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.19",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "express4": "npm:express@^4.22.3",
    "express5": "npm:express@^5.3.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.57.0",
    "msw": "^3.0.3",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  }
}
