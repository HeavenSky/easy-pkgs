{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": ["vite/client"],
		"paths": { "@/*": ["./src/ui/*"] }
	},
	"include": [
		"src/ui",
		"src/float/main.ts",
		"test/ui",
		"vite.config.mts",
		"vite.float.config.mts",
		"vitest.config.mts"
	]
}
